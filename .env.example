# Server-only Prismic Content API token (Settings → API & Security).
# Do not use NEXT_PUBLIC_* for this value — it must stay off the client bundle.
PRISMIC_ACCESS_TOKEN=

# Optional shared secret for /api/revalidate (must match the webhook secret in Prismic).
PRISMIC_WEBHOOK_SECRET=

# Optional: set by `npx prismic env set <domain>` when working against a Prismic Environment.
# NEXT_PUBLIC_PRISMIC_ENVIRONMENT=
